# ClimAPI Environment Configuration v2.0

# ===================
# Application
# ===================
APP_NAME=ClimAPI
APP_VERSION=2.0.0
ENVIRONMENT=development
DEBUG=false

# ===================
# API Server
# ===================
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000,http://localhost:8501

# ===================
# Logging
# ===================
LOG_LEVEL=INFO
LOG_FORMAT=text
LOG_TO_FILE=true

# ===================
# Cache
# ===================
CACHE_BACKEND=memory
CACHE_TTL_CURRENT=900
CACHE_TTL_FORECAST=3600

# ===================
# Directories
# ===================
DATA_DIR=data
CACHE_DIR=cache
LOG_DIR=logs

# ===================
# Default Location
# ===================
DEFAULT_LATITUDE=6.244
DEFAULT_LONGITUDE=-75.581
DEFAULT_TIMEZONE=America/Bogota

# ===================
# Open-Meteo (FREE - No API Key Required)
# ===================
OPENMETEO_BASE_URL=https://api.open-meteo.com/v1
OPENMETEO_FORECAST_DAYS=7

# ===================
# OpenWeatherMap (Optional)
# Get key: https://openweathermap.org/api
# ===================
# OPENWEATHER_API_KEY=your_key_here
# OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5/
# OPENWEATHER_UNITS=metric

# ===================
# MeteoBlue (Optional)
# Get key: https://www.meteoblue.com/
# ===================
# METEOBLUE_API_KEY=your_key_here
# METEOBLUE_SHARED_SECRET=your_secret_here

# ===================
# SIATA (Medellín - Local)
# ===================
SIATA_API_URL=https://www.siata.gov.co
SIATA_TIMEOUT=15

# ===================
# IDEAM Radar (FREE - AWS S3)
# ===================
IDEAM_RADAR_BUCKET=s3-radaresideam
IDEAM_RADAR_REGION=us-east-1

# ===================
# NASA Power (FREE)
# ===================
POWER_BASE_URL=https://power.larc.nasa.gov/api/v1/aggregate